module Dedalus
  module Models
    module Machines
      type preview_list =
        { items: ::Array[Dedalus::Machines::Preview]?, next_cursor: String }

      class PreviewList < Dedalus::Internal::Type::BaseModel
        attr_accessor items: ::Array[Dedalus::Machines::Preview]?

        attr_reader next_cursor: String?

        def next_cursor=: (String) -> String

        def initialize: (
          items: ::Array[Dedalus::Machines::Preview]?,
          ?next_cursor: String
        ) -> void

        def to_hash: -> {
          items: ::Array[Dedalus::Machines::Preview]?,
          next_cursor: String
        }
      end
    end
  end
end
