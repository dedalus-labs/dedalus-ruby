module Dedalus
  module Models
    module Machines
      type preview =
        {
          created_at: Time,
          machine_id: String,
          port: Integer,
          preview_id: String,
          status: Dedalus::Models::Machines::Preview::status,
          visibility: Dedalus::Models::Machines::Preview::visibility,
          error_code: String,
          error_message: String,
          expires_at: Time,
          protocol: Dedalus::Models::Machines::Preview::protocol,
          ready_at: Time,
          retry_after_ms: Integer,
          url: String
        }

      class Preview < Dedalus::Internal::Type::BaseModel
        attr_accessor created_at: Time

        attr_accessor machine_id: String

        attr_accessor port: Integer

        attr_accessor preview_id: String

        attr_accessor status: Dedalus::Models::Machines::Preview::status

        attr_accessor visibility: Dedalus::Models::Machines::Preview::visibility

        attr_reader error_code: String?

        def error_code=: (String) -> String

        attr_reader error_message: String?

        def error_message=: (String) -> String

        attr_reader expires_at: Time?

        def expires_at=: (Time) -> Time

        attr_reader protocol: Dedalus::Models::Machines::Preview::protocol?

        def protocol=: (
          Dedalus::Models::Machines::Preview::protocol
        ) -> Dedalus::Models::Machines::Preview::protocol

        attr_reader ready_at: Time?

        def ready_at=: (Time) -> Time

        attr_reader retry_after_ms: Integer?

        def retry_after_ms=: (Integer) -> Integer

        attr_reader url: String?

        def url=: (String) -> String

        def initialize: (
          created_at: Time,
          machine_id: String,
          port: Integer,
          preview_id: String,
          status: Dedalus::Models::Machines::Preview::status,
          visibility: Dedalus::Models::Machines::Preview::visibility,
          ?error_code: String,
          ?error_message: String,
          ?expires_at: Time,
          ?protocol: Dedalus::Models::Machines::Preview::protocol,
          ?ready_at: Time,
          ?retry_after_ms: Integer,
          ?url: String
        ) -> void

        def to_hash: -> {
          created_at: Time,
          machine_id: String,
          port: Integer,
          preview_id: String,
          status: Dedalus::Models::Machines::Preview::status,
          visibility: Dedalus::Models::Machines::Preview::visibility,
          error_code: String,
          error_message: String,
          expires_at: Time,
          protocol: Dedalus::Models::Machines::Preview::protocol,
          ready_at: Time,
          retry_after_ms: Integer,
          url: String
        }

        type status = :wake_in_progress | :ready | :closed | :expired | :failed

        module Status
          extend Dedalus::Internal::Type::Enum

          WAKE_IN_PROGRESS: :wake_in_progress
          READY: :ready
          CLOSED: :closed
          EXPIRED: :expired
          FAILED: :failed

          def self?.values: -> ::Array[Dedalus::Models::Machines::Preview::status]
        end

        type visibility = :public | :private | :org

        module Visibility
          extend Dedalus::Internal::Type::Enum

          PUBLIC: :public
          PRIVATE: :private
          ORG: :org

          def self?.values: -> ::Array[Dedalus::Models::Machines::Preview::visibility]
        end

        type protocol = :http | :https

        module Protocol
          extend Dedalus::Internal::Type::Enum

          HTTP: :http
          HTTPS: :https

          def self?.values: -> ::Array[Dedalus::Models::Machines::Preview::protocol]
        end
      end
    end
  end
end
