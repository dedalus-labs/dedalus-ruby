module Dedalus
  module Models
    module Machines
      type terminal =
        {
          created_at: Time,
          height: Integer,
          machine_id: String,
          status: Dedalus::Models::Machines::Terminal::status,
          terminal_id: String,
          width: Integer,
          error_code: String,
          error_message: String,
          expires_at: Time,
          protocol: Dedalus::Models::Machines::Terminal::protocol,
          ready_at: Time,
          retry_after_ms: Integer,
          stream_url: String
        }

      class Terminal < Dedalus::Internal::Type::BaseModel
        attr_accessor created_at: Time

        attr_accessor height: Integer

        attr_accessor machine_id: String

        attr_accessor status: Dedalus::Models::Machines::Terminal::status

        attr_accessor terminal_id: String

        attr_accessor width: Integer

        attr_reader error_code: String?

        def error_code=: (String) -> String

        attr_reader error_message: String?

        def error_message=: (String) -> String

        attr_reader expires_at: Time?

        def expires_at=: (Time) -> Time

        attr_reader protocol: Dedalus::Models::Machines::Terminal::protocol?

        def protocol=: (
          Dedalus::Models::Machines::Terminal::protocol
        ) -> Dedalus::Models::Machines::Terminal::protocol

        attr_reader ready_at: Time?

        def ready_at=: (Time) -> Time

        attr_reader retry_after_ms: Integer?

        def retry_after_ms=: (Integer) -> Integer

        attr_reader stream_url: String?

        def stream_url=: (String) -> String

        def initialize: (
          created_at: Time,
          height: Integer,
          machine_id: String,
          status: Dedalus::Models::Machines::Terminal::status,
          terminal_id: String,
          width: Integer,
          ?error_code: String,
          ?error_message: String,
          ?expires_at: Time,
          ?protocol: Dedalus::Models::Machines::Terminal::protocol,
          ?ready_at: Time,
          ?retry_after_ms: Integer,
          ?stream_url: String
        ) -> void

        def to_hash: -> {
          created_at: Time,
          height: Integer,
          machine_id: String,
          status: Dedalus::Models::Machines::Terminal::status,
          terminal_id: String,
          width: Integer,
          error_code: String,
          error_message: String,
          expires_at: Time,
          protocol: Dedalus::Models::Machines::Terminal::protocol,
          ready_at: Time,
          retry_after_ms: Integer,
          stream_url: String
        }

        type status = :wake_in_progress | :ready | :closed | :expired | :failed

        module Status
          extend Dedalus::Internal::Type::Enum

          WAKE_IN_PROGRESS: :wake_in_progress
          READY: :ready
          CLOSED: :closed
          EXPIRED: :expired
          FAILED: :failed

          def self?.values: -> ::Array[Dedalus::Models::Machines::Terminal::status]
        end

        type protocol = :websocket

        module Protocol
          extend Dedalus::Internal::Type::Enum

          WEBSOCKET: :websocket

          def self?.values: -> ::Array[Dedalus::Models::Machines::Terminal::protocol]
        end
      end
    end
  end
end
