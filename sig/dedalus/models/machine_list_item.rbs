module Dedalus
  module Models
    type machine_list_item =
      {
        autosleep_seconds: Integer,
        created_at: Time,
        desired_state: Dedalus::Models::MachineListItem::desired_state,
        machine_id: String,
        memory_mib: Integer,
        phase: Dedalus::Models::MachineListItem::phase,
        storage_gib: Integer,
        vcpu: Float
      }

    class MachineListItem < Dedalus::Internal::Type::BaseModel
      attr_accessor autosleep_seconds: Integer

      attr_accessor created_at: Time

      attr_accessor desired_state: Dedalus::Models::MachineListItem::desired_state

      attr_accessor machine_id: String

      attr_accessor memory_mib: Integer

      attr_accessor phase: Dedalus::Models::MachineListItem::phase

      attr_accessor storage_gib: Integer

      attr_accessor vcpu: Float

      def initialize: (
        autosleep_seconds: Integer,
        created_at: Time,
        desired_state: Dedalus::Models::MachineListItem::desired_state,
        machine_id: String,
        memory_mib: Integer,
        phase: Dedalus::Models::MachineListItem::phase,
        storage_gib: Integer,
        vcpu: Float
      ) -> void

      def to_hash: -> {
        autosleep_seconds: Integer,
        created_at: Time,
        desired_state: Dedalus::Models::MachineListItem::desired_state,
        machine_id: String,
        memory_mib: Integer,
        phase: Dedalus::Models::MachineListItem::phase,
        storage_gib: Integer,
        vcpu: Float
      }

      type desired_state = :running | :sleeping | :destroyed

      module DesiredState
        extend Dedalus::Internal::Type::Enum

        RUNNING: :running
        SLEEPING: :sleeping
        DESTROYED: :destroyed

        def self?.values: -> ::Array[Dedalus::Models::MachineListItem::desired_state]
      end

      type phase =
        :accepted
        | :placement_pending
        | :starting
        | :running
        | :stopping
        | :sleeping
        | :destroying
        | :destroyed
        | :failed

      module Phase
        extend Dedalus::Internal::Type::Enum

        ACCEPTED: :accepted
        PLACEMENT_PENDING: :placement_pending
        STARTING: :starting
        RUNNING: :running
        STOPPING: :stopping
        SLEEPING: :sleeping
        DESTROYING: :destroying
        DESTROYED: :destroyed
        FAILED: :failed

        def self?.values: -> ::Array[Dedalus::Models::MachineListItem::phase]
      end
    end
  end
end
