module Dedalus
  module Resources
    class Machines
      class Artifacts
        def retrieve: (
          machine_id: String,
          artifact_id: String,
          ?request_options: Dedalus::request_opts
        ) -> Dedalus::Machines::Artifact

        def list: (
          machine_id: String,
          ?cursor: String,
          ?limit: Integer,
          ?request_options: Dedalus::request_opts
        ) -> Dedalus::Internal::CursorPage[Dedalus::Machines::Artifact]

        def delete: (
          machine_id: String,
          artifact_id: String,
          ?request_options: Dedalus::request_opts
        ) -> Dedalus::Machines::Artifact

        def initialize: (client: Dedalus::Client) -> void
      end
    end
  end
end
